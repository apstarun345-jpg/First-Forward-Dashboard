# /etc/ffdash.env — Render → Service → Environment se SAARE values yahan copy karo (KEY=value, quotes nahi).
PORT=10000
# Render jaisa production behaviour (durable cloud storage check, stock-age warm-up)
RENDER=1
REQUIRE_DURABLE_CLOUD=1
DATA_DIR=/var/lib/ffdash
CACHE_SECONDS=600
# Bada server: cache + memory guard ki limit badhao (Render free = 512 MB tha)
CACHE_MAX_MB=512
MEM_SOFT_MB=3000
MEM_HEAP_SOFT_MB=3000
MEM_HARD_MB=3800
# Apna domain ho to (DNS A record → is server ka IP); khaali = <ip>.sslip.io
SITE_DOMAIN=

# ---- Render se copy (zaruri) ----
ADMIN_USER=
ADMIN_PASSWORD=
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
GV_TAG_MAPPING_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Render par jo aur env vars set hain (STORAGE_*, GOOGLE_SERVICE_ACCOUNT_JSON, FF_MAPPING_API_URL, …) wo bhi yahan
