{
  "name": "First Forward & Gv Partner Dashboard",
  "short_name": "FF & Gv Partner",
  "description": "ApnaPayment workspace \u2014 First Forward & GV issuance, stock and performance.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "orientation": "any",
  "background_color": "#111214",
  "theme_color": "#111214",
  "categories": [
    "business",
    "productivity",
    "finance"
  ],
  "icons": [
    {
      "src": "./icon-192.png?v=6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png?v=6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home Highlights",
      "url": "./#/home",
      "description": "GV & FF highlights charts"
    },
    {
      "name": "GV & FF Tag Issued",
      "url": "./#/tagIssued",
      "description": "Date-wise detailed issuance"
    },
    {
      "name": "Dashboard",
      "url": "./#/dashboard",
      "description": "First Forward dashboard"
    },
    {
      "name": "GV Dashboard",
      "url": "./#/gvDashboard",
      "description": "GV Partner dashboard"
    }
  ]
}
